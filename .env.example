# Database
DATABASE_URL=postgresql+asyncpg://noa:noa@localhost:5432/noa

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp (Meta Graph API) — leave empty to disable
WHATSAPP_PHONE_NUMBER_ID=   # Phone Number ID from Meta App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=      # System User permanent access token
WHATSAPP_VERIFY_TOKEN=      # Any secret string you set in Meta App → WhatsApp → Configuration → Webhook
WHATSAPP_APP_SECRET=        # App Secret from Meta App → Settings → Basic (optional but recommended)

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (Whisper)
OPENAI_API_KEY=

# Scaleway Object Storage
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_REGION=fr-par
SCW_BUCKET=noa-dev

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
