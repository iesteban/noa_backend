# Database
DATABASE_URL=postgresql+asyncpg://noa:noa@localhost:5433/noa

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp (Twilio) — leave empty to disable
TWILIO_ACCOUNT_SID=      # Your account SID — ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=      # API key SID — SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CLIENT_SECRET=    # Client secret shown once when the API key is created
TWILIO_WHATSAPP_FROM=    # Your Twilio WhatsApp number in E.164, e.g. +14155238886

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (Whisper)
OPENAI_API_KEY=

# Scaleway Object Storage
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_REGION=fr-par
SCW_BUCKET=noa-dev

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
